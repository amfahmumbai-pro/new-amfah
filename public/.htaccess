# ----------------------------------------------------------------------
# AMFAH - Apache Server Configuration & Technical SEO Redirects
# ----------------------------------------------------------------------

RewriteEngine On

# 1. True HTTP 404 Header Handling
# Prevents soft 404s by forcing Apache to return HTTP 404 status with /404.html
ErrorDocument 404 /404.html

# 2. Canonical Trailing Slash Normalization
# Next.js export produces directory-based index.html files (trailingSlash: true).
# Enforce trailing slash on all folder URLs (excluding real static files).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.(html|php|css|js|png|jpg|jpeg|webp|gif|svg|ico|pdf|txt|xml|json)$ [NC]
RewriteRule ^(.*)$ https://amfah.com/$1/ [L,R=301]

# 3. Permanently Removed Legacy Feeds, Categories & Utilities (HTTP 410 Gone)
# Tells Googlebot these legacy WordPress RSS feeds, author URLs, and obsolete URLs without genuine equivalents are permanently removed.
RewriteRule ^feed/?$ - [G,L]
RewriteRule ^.*/feed/?$ - [G,L]
RewriteRule ^author/ - [G,L]
RewriteRule ^comments/ - [G,L]
RewriteRule ^wp- - [G,L]
RewriteRule ^xmlrpc\.php - [G,L]
RewriteRule ^olimpia-splendid/?$ - [G,L]
RewriteRule ^amfah-group/?$ - [G,L]
RewriteRule ^index\.php/dm-series/?$ - [G,L]
RewriteRule ^industries/manufacturing/?$ - [G,L]
RewriteRule ^industries/cold-storage/?$ - [G,L]

# 4. Verified 301 Redirects: Legacy Exact-Match Product Slugs
# Direct 1-hop 301 redirects to the exact verified current product pages
RewriteRule ^amf-p18/?$ https://amfah.com/products/amf-pdac18/ [R=301,L]
RewriteRule ^index\.php/amf-p18-dac/?$ https://amfah.com/products/amf-pdac18/ [R=301,L]
RewriteRule ^amf-35-dm/?$ https://amfah.com/products/amf-35d-a/ [R=301,L]
RewriteRule ^index\.php/amf-35da/?$ https://amfah.com/products/amf-35d-a/ [R=301,L]
RewriteRule ^60-dm/?$ https://amfah.com/products/amf-60dmp/ [R=301,L]
RewriteRule ^amf-aqua-50/?$ https://amfah.com/products/amf-aqua-50/ [R=301,L]

# 5. Verified 301 Redirects: Legacy URLs with Verified Genuine Equivalents Only
# Dehumidifiers for Warehouse & Storage Facilities -> Live equivalent application page
RewriteRule ^dehumidifiers-for-warehouse-storage-facilities/?$ https://amfah.com/industrial-uses/warehouse-storage/ [R=301,L]
# Dehumidifiers for Library & Archives -> Live equivalent application page
RewriteRule ^dehumidifiers-for-library-archives/?$ https://amfah.com/home-uses/library-archives/ [R=301,L]
# Frequently Asked Questions -> Live equivalent FAQ page
RewriteRule ^frequently-asked-questions/?$ https://amfah.com/faq/ [R=301,L]
# Commercial Dehumidifiers legacy/alias URL -> Live Commercial/Industrial Dehumidifiers page
RewriteRule ^commercial-dehumidifiers/?$ https://amfah.com/industrial-dehumidifiers/ [R=301,L]
# Industrial Dehumidifiers Ceiling filter -> Dedicated Ceiling Dehumidifiers page
RewriteCond %{QUERY_STRING} ^filter=ceiling$ [NC]
RewriteRule ^industrial-dehumidifiers/?$ https://amfah.com/ceiling-dehumidifiers/? [R=301,L]

# 6. Verified 301 Redirects: Legacy Industry URLs to Live Genuinely Equivalent Application Pages Only
RewriteRule ^industries/warehouses/?$ https://amfah.com/industrial-uses/warehouse-storage/ [R=301,L]
RewriteRule ^industries/data-centers/?$ https://amfah.com/industrial-uses/it-data-center/ [R=301,L]
RewriteRule ^industries/hospitals/?$ https://amfah.com/industrial-uses/hospitals-clinics/ [R=301,L]
RewriteRule ^industries/hotels/?$ https://amfah.com/industrial-uses/hotels-restaurants/ [R=301,L]
RewriteRule ^industries/pharmaceutical-industry/?$ https://amfah.com/industrial-uses/pharmaceutical-industry/ [R=301,L]
RewriteRule ^industries/pharma/?$ https://amfah.com/industrial-uses/pharmaceutical-industry/ [R=301,L]

# 7. Security & Browser Caching Optimization
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
